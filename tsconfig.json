{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["packages/shared/*"]
    }
  },
  "include": [
    "apps/web/next-env.d.ts",
    "apps/web/.next/types/**/*.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "apps/web/.next/dev/types/**/*.ts",
    "apps/web/.next-test/types/**/*.ts",
    "apps/web/.next-test/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "obsolete",
    "old",
    "local",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
