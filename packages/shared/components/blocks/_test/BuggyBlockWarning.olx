<!-- Parse-time WARNING: the block parses and renders fine, but pushes an
     OLXLoadingError into result.errors (the warnings panel). The canary asserts
     the warning is recorded; the main demo-render suite now treats any such
     warning on a real fixture as fatal, so warnings can't be silently lost. -->
<BuggyBlock id="BuggyBlockWarning" throws="none" warn="true"
            message="BuggyBlock: deliberate non-fatal parse-time warning"/>
