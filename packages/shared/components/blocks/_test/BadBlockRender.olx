<!-- Render-time failure (native Error). In the app: caught by RenderOLX's
     ErrorBoundary → DisplayError + a render-error ErrorNode in the event log.
     In demo-render.test.ts (no boundary): mounting throws. -->
<BadBlock id="BadBlockRender" throws="render" kind="native"
            message="BadBlock: deliberate render-time failure (native Error)"/>
