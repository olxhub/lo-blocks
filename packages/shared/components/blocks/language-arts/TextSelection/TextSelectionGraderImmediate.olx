<!-- Composed IMMEDIATE-mode grading: grade="immediate" on the CapaProblem means
     correctness derives live as the learner clicks, with no Check button. The
     grader is the same TextSelectionGrader; only the problem's grade attribute
     differs from the submit example. -->
<CapaProblem id="immediate_nouns" grade="immediate" title="Highlight the nouns">
  <TextSelectionGrader>
    <TextSelectionInput>
Highlight the nouns as you read - the score updates live:
---
{The} [scientist] recorded {the} [temperature] of {the} [solution].
    </TextSelectionInput>
  </TextSelectionGrader>
</CapaProblem>
