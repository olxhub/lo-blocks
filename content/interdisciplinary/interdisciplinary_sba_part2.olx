<!-- Interdisciplinary Studies SBA, Part 2: Developing a Problem Statement -->
<Vertical id="interdisciplinary_sba2_root">

<!-- Main SBA Interface -->
<!--
---
description: Analyze high school dropout rates using interdisciplinary research methods and statistical reasoning (part 2)
category: interdisciplinary
index: 71
lang: en-Latn-US
---
-->
<Cast cast="characters.cast" id="interdisciplinary_sba_demo_part2" title="Interdisciplinary Studies SBA, Part 2 - Interdisciplinary Research Methods and Statistical Reasoning" launchable="true">
  <Tabs id="interdisciplinary_sba2_tabs">
    <!-- Tab 1: Student Current Work -->
   <Sequential id="interdisciplinary_part2_seq" title="Current Activity">

    <SplitPanel sizes="30, 70" id="interdisciplinary_part2_sp1">
      <!-- Left Panel: Dialogue Conversation -->
      <LeftPane>
        <Chat id="interdisciplinary_chat_orientation2"
            src="interdisciplinary_dialogue_part2.chatpeg"
            clip="orientation2"
            height="400px" />
      </LeftPane>

      <!-- Right Panel: Current Activity -->
      <RightPane>
          <Vertical id="interdisciplinary2_current_activity_a" title="Current Activity">
            <UseHistory id="interdisciplinary_sba_sidebar2_a" initial="interdisciplinary_orientation2" />
          </Vertical>
      </RightPane>
    </SplitPanel>

    <SplitPanel sizes="30, 70" id="interdisciplinary_part2_sp2">
      <!-- Left Panel: Dialogue Conversation -->
      <LeftPane>
        <Chat id="interdisciplinary_chat_introduction2"
            src="interdisciplinary_dialogue_part2.chatpeg"
            clip="interdisciplinary_introduction2"
            height="400px" />
      </LeftPane>

      <!-- Right Panel: Current Activity -->
      <RightPane>
          <Vertical id="interdisciplinary2_current_activity_b" title="Current Activity">
            <UseHistory id="interdisciplinary_sba_sidebar2_b" initial="insight_review" />
          </Vertical>
      </RightPane>
    </SplitPanel>

    <SplitPanel sizes="30, 70" id="interdisciplinary_part2_sp3">
      <!-- Left Panel: Dialogue Conversation -->
      <LeftPane>
        <Chat id="interdisciplinary_chat_multifactor"
            src="interdisciplinary_dialogue_part2.chatpeg"
            clip="interdisciplinary_multifactor"
            height="400px" />
      </LeftPane>

      <!-- Right Panel: Current Activity -->
      <RightPane>
          <Vertical id="interdisciplinary2_current_activity_c" title="Current Activity">
            <UseHistory id="interdisciplinary_sba_sidebar2_c" initial="dropout_cause_mapping" />
          </Vertical>
      </RightPane>
    </SplitPanel>

    <SplitPanel sizes="30, 70" id="interdisciplinary_part2_sp4">
      <!-- Left Panel: Dialogue Conversation -->
      <LeftPane>
        <Chat id="interdisciplinary_chat_additional_factors"
            src="interdisciplinary_dialogue_part2.chatpeg"
            clip="interdisciplinary_additional_factors"
            height="400px" />
      </LeftPane>

      <!-- Right Panel: Current Activity -->
      <RightPane>
          <Vertical id="interdisciplinary2_current_activity_d" title="Current Activity">
            <UseHistory id="interdisciplinary_sba_sidebar2_d" initial="dropout_factor_combos" />
          </Vertical>
      </RightPane>
    </SplitPanel>

    <SplitPanel sizes="30, 70" id="interdisciplinary_part2_sp5">
      <!-- Left Panel: Dialogue Conversation -->
      <LeftPane>
        <Chat id="interdisciplinary_chat_funding_text"
            src="interdisciplinary_dialogue_part2.chatpeg"
            clip="interdisciplinary_funding_text"
            height="400px" />
      </LeftPane>

      <!-- Right Panel: Current Activity -->
      <RightPane>
          <Vertical id="interdisciplinary2_current_activity_e" title="Current Activity">
            <UseHistory id="interdisciplinary_sba_sidebar2_e" initial="reading_funding_text" />
          </Vertical>
      </RightPane>
    </SplitPanel>

    <SplitPanel sizes="30, 70" id="interdisciplinary_part2_sp6">
      <!-- Left Panel: Dialogue Conversation -->
      <LeftPane>
        <Chat id="interdisciplinary_chat_part2_conclusion"
            src="interdisciplinary_dialogue_part2.chatpeg"
            clip="interdisciplinary_part_2_conclusion"
            height="400px" />
      </LeftPane>

      <!-- Right Panel: Current Activity -->
      <RightPane>
          <Vertical id="interdisciplinary2_current_activity_f" title="Current Activity">
            <UseHistory id="interdisciplinary_sba_sidebar2_f" initial="extended_summary_2" />
          </Vertical>
      </RightPane>
     </SplitPanel>
    </Sequential>

    <!-- Tab 2: Student Artifact -->
    <Vertical id="interdisciplinary2_artifact_tab" title="Artifact">
      <Use ref="interdisciplinary_artifact" />
    </Vertical>

    <!-- Tab 3: Library of Readings -->
    <Vertical id="interdisciplinary2_library_tab" title="Library">
      <Use ref="interdisciplinary_library" />
    </Vertical>

    <!-- Tab 4: Team Directory -->
    <Vertical id="interdisciplinary2_directory" title="Team">
      <Use ref="interdisciplinary_team_members" />
    </Vertical>
  </Tabs>
</Cast>

</Vertical>
