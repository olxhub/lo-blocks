      <Markdown>*Source: https://en.wikipedia.org/wiki/Union_Jack (confidence: medium)*</Markdown>
    </Explanation>
  </KeyGrader>
</CapaProblem>

<CapaProblem id="uk_pol_flag_names" title="The Union Jack" dontKnow="true">
  <KeyGrader>
