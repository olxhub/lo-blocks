      <Markdown>*Source: https://en.wikipedia.org/wiki/Albert_Memorial (confidence: high)*</Markdown>
    </Explanation>
  </KeyGrader>
</CapaProblem>

<CapaProblem id="uk_albert_statue" title="Kensington Gardens: Albert Memorial" dontKnow="true">
