<CapaProblem id="uk_pol_conservative" title="The two major parties" dontKnow="true">
  <KeyGrader>
    <Markdown>Which manifesto of 1834 launched the Conservative Party?</Markdown>
    <ChoiceInput>
      <Distractor>The Peterloo Manifesto</Distractor>
      <Distractor>The Peelite Declaration</Distractor>
      <Key>The Tamworth Manifesto, by Robert Peel</Key>
      <Distractor>The Gladstone Charter</Distractor>
    </ChoiceInput>
