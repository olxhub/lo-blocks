<Cast cast="characters.cast" id="interdisciplinary_activities_part3" title="Activities for Part 3 of Interdisciplinary Studies SBA on High School Dropout Rates" launchable="true">
<Vertical>

  <ActionButton id="print_interdisciplinary_part3_btn" label="Export as PDF">
