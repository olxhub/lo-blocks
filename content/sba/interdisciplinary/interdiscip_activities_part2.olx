    &nbsp;
    
    **Why did you choose the sentence you picked?**</Markdown>
          <TextArea id="cause_connection_3_choice_explanation" 
              placeholder="Put your answer here..." /> 
       </Vertical>              
      </IntakeGate>
     </LeftPane>
