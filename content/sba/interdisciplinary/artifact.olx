            </SplitPanel>
          </RightPane>
        </SplitPanel>
      </IntakeGate>
      <IntakeGate ready="@dropout_factor_combo_5_explanation.value || @cause_connection_5_explanation.value || @cause_connection_5_choice_explanation.value">
