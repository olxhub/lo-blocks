  <!-- Step 5: Critical Analysis -->
  <Collapsible id="artifact_step5" title="Step 5: Critically analyze the disciplinary insights and identify conflicts">
    <Markdown>
Analysis of how different disciplines view the problem and where they conflict.
    </Markdown>
    <Tabs>
      <Vertical title="Causal Diagram (Version 1)">
        <SplitPanel>
          <LeftPane><Markdown>**My Causal Diagram**</Markdown></LeftPane>
          <RightPane><Markdown>**Group Consensus for Causal Diagram**</Markdown></RightPane>
        </SplitPanel>
        <SplitPanel>
          <LeftPane>
            <IntakeGate ready="@initial_links_done.value">
              <Markdown>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;**Not Final**</Markdown>
              <Hidden> </Hidden>
            </IntakeGate>
            <Mermaid target="editor_cause_diagram" />
          </LeftPane>
          <RightPane>
            <IntakeGate ready="@initial_links_done.value">
              <Markdown>**Not shown until your work is marked complete**</Markdown>
              <Mermaid target="cause_mapping" />
            </IntakeGate>
          </RightPane>
        </SplitPanel>
      </Vertical>
      <Vertical title="Causal Diagram (Version 2)">
        <IntakeGate ready="@initial_links_done.value">
          <Markdown>**Not shown until previous diagram marked complete**</Markdown>
          <Vertical>
            <SplitPanel id="causal_diagram_v2_headers">
              <LeftPane><Markdown>**My Causal Diagram**</Markdown></LeftPane>
              <RightPane><Markdown>**Group Consensus for Causal Diagram**</Markdown></RightPane>
            </SplitPanel>
            <SplitPanel id="causal_diagram_v2_content">
              <LeftPane><Mermaid target="editor" /></LeftPane>
              <RightPane>
                <IntakeGate ready="@extra_links_done.value">
                  <Markdown>**Not shown until previous diagram marked complete**</Markdown>
                  <Mermaid target="cause_mapping_3" />
                </IntakeGate>
              </RightPane>
            </SplitPanel>
          </Vertical>
        </IntakeGate>
      </Vertical>
      <Vertical title="Final Causal Diagram">
        <IntakeGate ready="@extra_links_done.value">
          <Markdown>**Not shown until previous diagram marked complete**</Markdown>
          <Vertical>
            <SplitPanel id="final_causal_diagram_headers">
              <LeftPane><Markdown>**My Causal Diagram**</Markdown></LeftPane>
              <RightPane><Markdown>**Group Consensus for Causal Diagram**</Markdown></RightPane>
            </SplitPanel>
            <SplitPanel id="final_causal_diagram_content">
              <LeftPane><Mermaid target="editor_finance_reform" /></LeftPane>
              <RightPane>
                <IntakeGate ready="@extra_links_done_finance_reform.value">
                  <Markdown>**Not shown until previous diagram marked complete**</Markdown>
                  <Mermaid target="cause_mapping_4" />
                </IntakeGate>
              </RightPane>
            </SplitPanel>
          </Vertical>
        </IntakeGate>
    </Vertical>
    </Tabs>    
    
  <IntakeGate ready="@cause_mapping_choice_explanation.value">
    <TextBlock>A table of factor interactions will be shown here once you have completed your first causal factor diagram</TextBlock>
    <Vertical id="table_of_connections">
      <SplitPanel sizes="30,70">
        <LeftPane><Markdown>## Factor Interactions</Markdown></LeftPane>
        <RightPane>
          <SplitPanel>
            <LeftPane>
              <SplitPanel>
                <LeftPane><Markdown>## My initial hypothesis</Markdown></LeftPane>
                <RightPane><Markdown>## My second take</Markdown></RightPane>
              </SplitPanel>
            </LeftPane>
            <RightPane><Markdown>## Final group consensus</Markdown></RightPane>
          </SplitPanel>
        </RightPane>
      </SplitPanel>
      <SplitPanel sizes="30,70">
        <LeftPane><Markdown>
**Family and Peer Factors | Students Working Long Hours**

**Relevant Disciplines**: Sociology, Economics
</Markdown></LeftPane>
        <RightPane>
          <SplitPanel>
            <LeftPane />
            <RightPane><Use ref="first_crosslink_sentence" /></RightPane>
          </SplitPanel>
        </RightPane>
      </SplitPanel>
      <IntakeGate ready="@dropout_factor_combo_1_explanation.value || @editor_finance_reform.value">
        <Markdown> </Markdown>
        <SplitPanel sizes="30,70">
          <LeftPane><Markdown>**Family and Peer Factors | Equitable School Funding**</Markdown></LeftPane>
          <RightPane>
            <SplitPanel>
              <LeftPane><Markdown>_{{@dropout_factor_combo_1_explanation.value}}_</Markdown></LeftPane>
              <RightPane><TextBlock>No interaction</TextBlock></RightPane>
            </SplitPanel>
          </RightPane>
        </SplitPanel>
      </IntakeGate>
      <IntakeGate ready="@dropout_factor_combo_2_explanation.value || @cause_connection_3_explanation.value || @cause_connection_3_choice_explanation.value">
        <Markdown> </Markdown>
        <SplitPanel sizes="30,70">
          <LeftPane><Markdown>
**Family and Peer Factors | ADHD Status**

**Relevant Disciplines**: Sociology, Psychology
          </Markdown></LeftPane>
          <RightPane>
             <SplitPanel>
               <LeftPane>
                 <SplitPanel>
                   <LeftPane><Markdown>_{{@dropout_factor_combo_2_explanation.value}}_</Markdown></LeftPane>                 
                   <RightPane><Markdown>_{{@cause_connection_3_explanation.value}}_</Markdown></RightPane>
                  </SplitPanel>
               </LeftPane>
               <RightPane>
                 <IntakeGate ready="@cause_connection_3_choice_explanation.value">
                  <Markdown>Not displayed until your input is completed.</Markdown>
                  <Use ref="factor_connection_1_key" />
                 </IntakeGate>
               </RightPane>
             </SplitPanel>
          </RightPane>
        </SplitPanel>
      </IntakeGate>
      <IntakeGate ready="@dropout_factor_combo_3_explanation.value || @cause_connection_4_explanation.value || @cause_connection_4_choice_explanation.value">
        <Markdown> </Markdown>
        <SplitPanel sizes="30,70">
          <LeftPane><Markdown>
**Students Working Long Hours | Equitable School Funding**

**Relevant Disciplines**: Sociology, Economics, Political Science
          </Markdown></LeftPane>
          <RightPane>
            <SplitPanel>
              <LeftPane>
                <SplitPanel>
                  <LeftPane><Markdown>_{{@dropout_factor_combo_3_explanation.value}}_</Markdown></LeftPane>
                  <RightPane><Markdown>_{{@cause_connection_4_explanation.value}}_</Markdown></RightPane>
                </SplitPanel>
              </LeftPane>
              <RightPane>
                <IntakeGate ready="@cause_connection_4_choice_explanation.value">
                  <Markdown>Not displayed until your input is completed.</Markdown>
                  <Use ref="factor_connection_2_key" />
                </IntakeGate>
              </RightPane>
            </SplitPanel>
          </RightPane>
        </SplitPanel>
      </IntakeGate>
      <IntakeGate ready="@dropout_factor_combo_4_explanation.value || @editor_finance_reform.value">
        <Markdown> </Markdown>
        <SplitPanel sizes="30,70">
          <LeftPane><Markdown>
**Students Working Long Hours | ADHD Status**

**Relevant Disciplines**: Economics, Sociology, Psychology
          </Markdown></LeftPane>
          <RightPane>
            <SplitPanel>
              <LeftPane><Markdown>_{{@dropout_factor_combo_4_explanation.value}}_</Markdown></LeftPane>
