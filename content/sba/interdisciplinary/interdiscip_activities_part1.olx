      <Vertical id="source_4_insight_input_t1" title="Write Insight Sentence">
        <Markdown>
**Write your sentence for the insight of this source.**
        </Markdown>
        <TextArea id="source_4_insight_sentence" placeholder="..." />
      </Vertical>
      <Vertical id="funding_study_insight_t2" title="Funding Study">
        <Use id="funding_study_text_md4" ref="funding_study_text_md" />
      </Vertical>
    </Tabs>


  <!-- Additional Disciplines Selection -->
  <Tabs id="source_4_insight_selection_input">
    <Vertical id="source_4_insight_selection_input_t1" title="Select Best Insight Sentence">
      <Markdown>
**Which of these sentences best describes the insight of this article?**
      </Markdown>
      <ChoiceInput id="source4_insight_selection">
        <Distractor>African American students attending high-need schools are at greatest risk.</Distractor>
        <Distractor><Ref target="source_4_insight_sentence" /></Distractor>
        <Key>Inadequate school funding is linked to higher dropout rates among African American students, underscoring the need for funding reforms to improve resources in high-poverty schools.</Key>
        <Distractor>Students in underfunded schools face increased risks due to fewer academic and support services.</Distractor>
      </ChoiceInput>
    </Vertical>
    <Vertical id="funding_study_insight_selection_t2" title="Funding Study">
      <Use id="funding_study_text_md5" ref="funding_study_text_md" />
    </Vertical>
  </Tabs>

    <!-- Funding study explanation input -->
  <Tabs id="source_4_insight_explanation_input">
    <Vertical id="source_4_insight_explanation_input_t1" title="Explain Your Choice">
      <Markdown>
**You chose the following sentence:**
      </Markdown>
      <Use ref="source4_insight_selection" />
      <Markdown>
**Why did you select this choice? Type your answer below.**
      </Markdown>
      <TextArea id="source_4_insight_sentence_explanation" placeholder="..." />
    </Vertical>
    <Vertical id="funding_study_insight_selection_explanation_t2" title="Funding Study">
      <Use id="funding_study_text_md6" ref="funding_study_text_md" />
    </Vertical>
  </Tabs>
 </Vertical>
 
   <!-- Completion summary -->
  <Vertical id="completion_interdisciplinary_1" >
  <CheckboxInput id="interdisciplinary_1_completion_page">
    <Markdown id="interdisciplinary_1_confirmation">**Confirm that you are done with this exercise.**</Markdown>
    <Key id="Part_1_finished">I don't need to make any more changes</Key>
  </CheckboxInput>
  <IntakeGate ready="'Part_1_finished' in @interdisciplinary_1_completion_page.value">
   <Markdown> </Markdown>
   <Markdown>
## Part 1 Complete!
  
## PLEASE CLICK CONTINUE TO REVIEW YOUR RESPONSES AND SAVE THEM TO A PDF. THEN UPLOAD THE PDF TO YOUR COURSE SYSTEM.
     </Markdown>
   </IntakeGate>
  </Vertical>

 
</Vertical>
