   <IntakeGate ready="!@interdisciplinary_1_completion_page.value">
    <Markdown> </Markdown>
     <Vertical id="reasons_list">
     <Markdown id="full_cause_list">
## List of causes of high school dropout
 - Some school systems can't accommodate students with physical or other disabilities
 - Students need to earn money right away to help their family
 - Schools use curricula that students don't see as relevant
 - Student's environment with gang activity, neighborhood instability
 - Conditions like depression, anxiety, or ADHD interfere with engagement
 - Students lack family, friends, or teacher support
 - Negative peer influences encourage dropping out
 - Cultural responsibilities more important than high school
 - Legal trouble makes it difficult to continue school
 - Lack of school funding for support services
 - Teen pregnancy with no school support
 - Substance abuse issues
      </Markdown>
     </Vertical>
    </IntakeGate>

   <IntakeGate ready="!@interdisciplinary_1_completion_page.value">
     <Vertical>
        <Markdown>
### Disciplines that might be relevant to the causes of high school dropout the group has identified.
**List your choices here.**
        </Markdown>
       <Use ref="disciplines" />
     </Vertical>
     <SplitPanel id="brainstorming_disciplines">
      <LeftPane>      
        <Use ref="full_cause_list" />
      </LeftPane>
      <RightPane>
        <Markdown>
## Disciplines that might be relevant to these causes
**List your choices here.**
        </Markdown>
        <DynamicList id="disciplines">
          <LineInput id="discipline_name" placeholder="Enter a discipline..." />
        </DynamicList>
      </RightPane>
     </SplitPanel>
    </IntakeGate>
    <!-- Checklist of reasons to research -->
    <Vertical id="reasons_checklist">
      <Markdown>
_Select the causes you think are most important to research._

**Choose at least three but no more than five.**
      </Markdown>
      <CheckboxInput id="reasons">
        <Key id="reason_disability" value="School systems can't accommodate disabilities">Some school systems can't accommodate students with physical or other disabilities</Key>
        <Key id="reason_money" value="Students need to earn money for family">Students need to earn money right away to help their family</Key>
        <Key id="reason_relevance" value="Curricula not seen as relevant">Schools use curricula that students don't see as relevant</Key>
        <Key id="reason_environment" value="Gang activity and neighborhood instability">Student's environment with gang activity, neighborhood instability</Key>
        <Key id="reason_mental_health" value="Depression, anxiety, or ADHD">Conditions like depression, anxiety, or ADHD interfere with engagement</Key>
        <Key id="reason_support" value="Lack of family/teacher support">Students lack family, friends, or teacher support</Key>
        <Key id="reason_peers" value="Negative peer influences">Negative peer influences encourage dropping out</Key>
        <Key id="reason_cultural" value="Cultural responsibilities">Cultural responsibilities more important than high school</Key>
        <Key id="reason_legal" value="Legal trouble">Legal trouble makes it difficult to continue school</Key>
        <Key id="reason_funding" value="Lack of school funding">Lack of school funding for support services</Key>
        <Key id="reason_pregnancy" value="Teen pregnancy without support">Teen pregnancy with no school support</Key>
        <Key id="reason_substance" value="Substance abuse">Substance abuse issues</Key>
      </CheckboxInput>
    </Vertical>

