{
  "extends": ["next/core-web-vitals"],
  "rules": {
    "react/no-unescaped-entities": ["error", {"forbid": [">", "}"]}]
  },
  "overrides": [
    {
      "files": ["packages/shared/components/blocks/**/_*.jsx", "packages/shared/components/blocks/**/_*.tsx", "packages/shared/components/blocks/*.jsx"],
      "rules": {
        "react-hooks/rules-of-hooks": "off"
      }
    },
    {
      "files": ["packages/shared/**/*.ts", "packages/shared/**/*.tsx", "packages/shared/**/*.js", "packages/shared/**/*.jsx"],
      "rules": {
        "no-restricted-imports": ["warn", {
          "patterns": [{
            "group": ["next/*"],
            "message": "packages/shared should not depend on Next.js. Use a platform-agnostic alternative or move this to apps/web/."
          }]
        }]
      }
    }
  ]
}