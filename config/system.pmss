/* config/system.pmss
 *
 * System-wide configuration defaults and deployment rules.
 * Course-level overrides.pmss layers on top via PMSS specificity.
 *
 * Classes come from three sources, combined into one context:
 *   - App profile: static, web, client   (from build system)
 *   - Deployment:  development, production (from env)
 *   - Content:     whatever manifest.yaml classes: declares
 */

/* Conservative defaults — no server features */
* {
    websocket: false;
    persistence: none;
    auth: none;
    translanguaging: true;
    debug-panel: true;   /* on by default; ctrl-` toggles it. Rarely disabled. */
    copyright: "";
    /* Off since 2026-07-07: server fan-out (fields-design step 2a)
     * subsumes tab-sync — sibling tabs receive each other's events over
     * their own sockets. Running both double-applies events (RGA splices
     * duplicate text). Retire tab-sync fully once fan-out soaks. */
    tab-sync: false;
    /* Runtime dynamic block loading (docs/dynamic-blocks.md). Off by default:
     * a dynamic block is untrusted code run on the server and in every
     * browser. Enabled below for development only. */
    dynamicBlockLoading: false;
}

/* Development deployments may load blocks at runtime. The `development` class
 * is injected by loadServerConfig based on NODE_ENV (see config.ts). */
.development {
    dynamicBlockLoading: true;
}

/* Server-backed apps: websocket + session persistence */
.web {
    websocket: true;
    persistence: blob;
    auth: session;
}

.client {
    websocket: true;
    persistence: blob;
    auth: session;
}

/* Content classes — declared in course manifest.yaml */
.no-translanguaging {
    translanguaging: false;
}
