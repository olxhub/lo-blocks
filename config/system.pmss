/* config/system.pmss
 *
 * System-wide configuration defaults and deployment rules.
 * Course-level overrides.pmss layers on top via PMSS specificity.
 *
 * Classes come from three sources, combined into one context:
 *   - App profile: static, web, client   (from build system)
 *   - Deployment:  development, production (from env)
 *   - Content:     whatever manifest.yaml classes: declares
 */

/* Conservative defaults — no server features */
* {
    websocket: false;
    persistence: none;
    auth: none;
    translanguaging: true;
    debug-panel: false;
    copyright: "";
    tab-sync: false;
}

/* Server-backed apps: websocket + session persistence */
.web {
    websocket: true;
    persistence: blob;
    auth: session;
}

.client {
    websocket: true;
    persistence: blob;
    auth: session;
}

/* Deployment overrides */
.development {
    debug-panel: true;
}

.production {
    debug-panel: false;
}

/* LLM defaults — stub provider, conservative limits */
* {
    llm-provider: stub;
    llm-model: "";
    llm-max-tokens: 4096;
    llm-rpm: 20;
    llm-token-budget: 100000;
}

/* Server-side LLM: real provider (overridden by env vars if set) */
.server {
    llm-provider: bedrock;
}

/* Tighter limits for unauthenticated (guest) users */
.server.guest {
    llm-rpm: 5;
    llm-token-budget: 10000;
}

/* Per-profile overrides */
.server[profile="interactive"] {
    llm-max-tokens: 4096;
}

.server[profile="translation"] {
    llm-max-tokens: 16384;
}

/* Content classes — declared in course manifest.yaml */
.no-translanguaging {
    translanguaging: false;
}
