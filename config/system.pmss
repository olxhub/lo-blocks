/* config/system.pmss
 *
 * System-wide configuration defaults and deployment rules.
 * Course-level overrides.pmss layers on top via PMSS specificity.
 *
 * Resolution context includes:
 *   - Runtime type/profile: client, server, static, or build
 *   - Deployment classes: development, production, credential availability
 *   - Content facts: runtime-resolved namespace/source origin plus
 *     author-controlled manifest.yaml classes and attributes
 *
 * Security policy must use platform-owned facts such as origin. Manifest
 * classes and attributes are preferences selected by the content author, not
 * evidence that the source is trusted.
 */

/* Conservative defaults — no server features */
* {
    websocket: false;
    persistence: none;
    auth: none;
    translanguaging: true;
    debug-panel: true;   /* on by default; ctrl-` toggles it. Rarely disabled. */
    copyright: "";
    /* Arbitrary JavaScript embedded in OLX (currently CustomGrader and
     * ObservablePlot format="js") runs with the viewer's browser authority.
     * Enable only where executable content cannot cross a trust boundary —
     * notably, one user's social/shared content must not execute for another. */
    allow-unsafe-content: false;
    /* Off since 2026-07-07: server fan-out (fields-design step 2a)
     * subsumes tab-sync — sibling tabs receive each other's events over
     * their own sockets. Running both double-applies events (RGA splices
     * duplicate text). Retire tab-sync fully once fan-out soaks. */
    tab-sync: false;

    /* WHERE A COURSE'S RECORDS ARE ARCHIVED. The LOCATION is a setting and is
     * committed, so a clone has a working default and moving provider is one
     * line. CREDENTIALS ARE NEVER HERE -- rclone keeps them in
     * ~/.config/rclone/rclone.conf, outside the tree. A course may name its own
     * location in its rubric frontmatter, which wins over this.
     *
     * NO FOLDER ID, deliberately. The remote authenticates with the `drive.file`
     * scope, which can see only files rclone itself created -- so it cannot
     * reach a pre-existing folder by id, and does not need to: it makes its own
     * root on first write. The narrower scope is also why a colleague
     * authorising this app grants access to the archive alone rather than to
     * their whole Drive. */
    archive-remote: "coursedata:lo-blocks-archive/courses";
}

/* Server-backed apps: websocket + session persistence */
.web {
    websocket: true;
    persistence: blob;
    auth: session;
}

.client {
    websocket: true;
    persistence: blob;
    auth: session;
}

/* Content classes — declared in course manifest.yaml */
.no-translanguaging {
    translanguaging: false;
}
