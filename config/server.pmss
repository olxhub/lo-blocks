/* config/server.pmss
 *
 * Server-only configuration — NOT served to clients.
 *
 * LLM provider settings, rate limits, and per-profile overrides live here
 * so they aren't exposed via /api/config. The server loads this file
 * alongside system.pmss at startup.
 */

/* LLM defaults — stub provider, conservative limits */
* {
    llm-provider: stub;
    llm-model: "";
    llm-max-tokens: 4096;
    llm-rpm: 20;
    llm-token-budget: 100000;
}

/* Server-side LLM: real provider (overridden by env vars if set) */
.server {
    llm-provider: bedrock;
}

/* Tighter limits for unauthenticated (guest) users */
.server.guest {
    llm-rpm: 5;
    llm-token-budget: 10000;
}

/* Per-profile overrides */
.server[profile="interactive"] {
    llm-max-tokens: 4096;
}

.server[profile="translation"] {
    llm-max-tokens: 16384;
}
