{
  "name": "lo-blocks",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run server & npm run dev:client & npm run dev:next",
    "dev:client": "./sandbox.sh npx vite build --watch --logLevel warn apps/client",
    "dev:crdt": "NEXT_PUBLIC_LO_FIELD_STRATEGY=crdt npm run dev",
    "dev:full": "npm run build && npm run dev",
    "dev:legacy": "npm run server:legacy & npm run dev:next",
    "dev:next": "./sandbox.sh next dev apps/web --turbopack",
    "dev:static": "./sandbox.sh npx vite dev apps/static",
    "server": "./sandbox.sh ./node_modules/.bin/tsx --watch apps/server/src/index.ts",
    "server:legacy": "./sandbox.sh ./node_modules/.bin/tsx packages/shared/scripts/event-server.ts",
    "start": "./sandbox.sh next start apps/web",
    "build": "npm run build:grammars && npm run build:parser-registry && npm run build:gen-block-registry && npm run build:content",
    "build:client": "./sandbox.sh npx vite build apps/client",
    "build:clean": "npm run clean && npm run clean-zombies ; npm install && npm run build",
    "_comment_build_content": "HACK: build:content runs content generation scripts. This should be replaced with a proper templated build system.",
    "build:content": "./sandbox.sh ./node_modules/.bin/tsx content/sba/psychology/convert-psych-mcq.js content/sba/psychology/operant-questions.json && ./sandbox.sh ./node_modules/.bin/tsx content/sba/psychology/convert-psych-mcq.js content/sba/psychology/function-questions.json",
    "build:generate-docs": "./sandbox.sh node packages/shared/scripts/generate-docs.js",
    "build:gen-block-registry": "./sandbox.sh node packages/shared/scripts/generateBlockRegistry.js",
    "build:grammars": "./sandbox.sh ./node_modules/.bin/tsx packages/shared/scripts/compile-grammars.ts",
    "build:parser-registry": "./sandbox.sh ./node_modules/.bin/tsx packages/shared/scripts/generate-parser-registry.ts",
    "build:prod": "npm run build && npm run build:client && npm run build:sync-images && ./sandbox.sh next build apps/web",
    "build:static": "npm run build && npm run build:static-content && ./sandbox.sh npx vite build apps/static && ./sandbox.sh ./node_modules/.bin/tsx apps/static/scripts/stamp-pages.ts && ./sandbox.sh ./node_modules/.bin/tsx packages/shared/scripts/sync-images.ts --target apps/static/dist/content",
    "build:static-content": "./sandbox.sh ./node_modules/.bin/tsx packages/shared/scripts/xml2json.ts --static-dir apps/static/public/static-content",
    "build:sync-images": "./sandbox.sh ./node_modules/.bin/tsx packages/shared/scripts/sync-images.ts",
    "typecheck": "./sandbox.sh npx tsc --noEmit",
    "lint": "./sandbox.sh next lint apps/web",
    "test": "npm run typecheck && ./sandbox.sh vitest",
    "test:ci": "npm run typecheck && ./sandbox.sh vitest run",
    "test:unit": "./sandbox.sh vitest --exclude='**/integration/**'",
    "test:ui": "./sandbox.sh vitest --ui",
    "smoke": "playwright test --config apps/web/playwright.smoke.config.ts",
    "clean": "./sandbox.sh rm -rf apps/web/.next apps/web/.next-test apps/static/.next apps/static/dist apps/client/dist node_modules .turbo out apps/web/public/content apps/static/public/static-content",
    "clean-translations": "./sandbox.sh ./node_modules/.bin/tsx packages/shared/scripts/clean-translations.ts",
    "clean-zombies": "pkill -9 -f '[n]ext-server' ; pkill -9 -f '[n]ext dev' ; pkill -9 -f '[p]ostcss.js' ; pkill -9 -f '[e]vent-server' ; pkill -9 -f '[v]ite.*apps/client' ; pkill -9 -f '[f]irejail.*apps/server' ; pkill -9 -f '[t]sx.*apps/server' ; pkill -9 -f '[n]ode.*apps/server/src'",
    "serve:static": "./sandbox.sh npx serve apps/static/dist",
    "upgrade-olx": "./sandbox.sh ./node_modules/.bin/tsx packages/shared/scripts/upgrade-olx.ts",
    "xml2json": "./sandbox.sh ./node_modules/.bin/tsx packages/shared/scripts/xml2json.ts",
    "xml2graph": "./sandbox.sh ./node_modules/.bin/tsx packages/shared/scripts/xml2graph.js"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.958.0",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@dicebear/core": "^9.3.1",
    "@dicebear/open-peeps": "^9.3.1",
    "@fontsource-variable/eb-garamond": "^5.2.7",
    "@fontsource-variable/playfair-display": "^5.2.8",
    "@fontsource/geist-mono": "^5.2.6",
    "@fontsource/geist-sans": "^5.2.5",
    "@hono/node-server": "^1.14.1",
    "@hono/zod-validator": "^0.8.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@observablehq/plot": "^0.6.17",
    "@tailwindcss/typography": "^0.5.19",
    "@uiw/react-codemirror": "^4.23.12",
    "@xyflow/react": "^12.6.0",
    "cldr-core": "^48.1.0",
    "codemirror": "^6.0.1",
    "crypto-js": "^4.2.0",
    "dagre": "^0.8.5",
    "fast-xml-parser": "^5.0.9",
    "hono": "^4.7.10",
    "html-tags": "^5.0.0",
    "i18next": "^25.4.0",
    "ioredis": "^5.11.0",
    "js-yaml": "^4.1.1",
    "json-stable-stringify": "^1.3.0",
    "katex": "^0.16.22",
    "lo_event": "^0.0.5",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.510.0",
    "mathjs": "^15.1.1",
    "mermaid": "^10.9.5",
    "next": "^16.1.1",
    "openai": "^5.3.0",
    "peggy": "^5.0.2",
    "pmss": "^0.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.1.1",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-split": "^2.0.14",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "yaml": "^2.8.2",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4",
    "@testing-library/react": "^16.3.0",
    "@types/http-proxy": "^1.17.17",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "get-port": "^7.1.0",
    "glob": "^11.0.2",
    "http-proxy": "^1.18.1",
    "jsdom": "^26.1.0",
    "minimatch": "^10.0.1",
    "postcss-nesting": "^13.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.2",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "ws": "^8.19.0"
  }
}
