# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/apps/web/test-results/

# next.js
apps/web/.next/
apps/web/.next-test/
apps/static/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Compiled parsers
packages/shared/components/blocks/**/_*Parser.js
packages/shared/lib/template/**/_*Parser.js
packages/shared/lib/stateLanguage/**/_*Parser.js
packages/shared/lib/grading/calc/_grammarParser.js

# Autogenerated
packages/shared/components/blockRegistryAutogen.ts
packages/shared/components/blockMetadataAutogen.json
packages/shared/generated/pegExtensions.json
packages/shared/generated/parserRegistry.ts
packages/shared/styles/componentsAutogen.css
packages/shared/lib/i18n/blockI18nAutogen.ts
packages/shared/lib/config.generated.ts

# Autosaves
*~
*\#

# Copied images
public/content
apps/server/public/content
apps/static/public/static-content

# Autogenerated content (translations, generated question banks, etc.)
*.auto.olx
*.auto.idlistpeg

# Logs
logs/

# Captured event streams (from event-server)
events/

# Server-side persistent data (SQLite KVS, etc.)
data/

# Local PMSS overrides (deploy-specific, not committed)
config/local.pmss

# Runtime artifacts (ephemeral, machine-local)
lofs/runtime/

# Various places interim development artifacts might go
/old/
/obsolete/
/local/
/tmp/
/uncommitted/
/prototypes/
/apps/static/out/
/apps/static/dist/
/apps/client/dist/
/apps/client/node_modules/
/dist/

# Local checkouts of repos
/local-repos

# Deployment-specific content source overrides (committed default is
# config/content-sources.yaml)
config/content-sources.local.yaml

# Access tokens / secrets (e.g. GitHub PAT for git-backed content sources).
# Never commit. Default token file is config/github.pat
config/*.pat
/apps/client/test-results/
.#*

# Build staging: content copied and corpus references resolved into it.
# Never committed -- it holds resolved student text by construction.
.stage/

# MOUNTED COURSE REPOSITORIES. A course reaches the build as a SYMLINK under
# content/ (materialiseRubrics prints "staged mounted source <ns>"), and the
# link points at wherever that repo lives on THIS machine. Committing one would
# hand everyone else a broken absolute path. Create your own with:
#   ln -sfn /path/to/edu.memphis.psych content/edu.memphis.psych
content/edu.memphis.*

# BUILD SCRATCH DIRECTORIES. `scripts/build-static.ts` writes into a
# `.tmp-build-XXXXXX` beside the repository root and is meant to clear it; an
# interrupted run leaves one behind, and the leftover then shows up as
# untracked content indistinguishable from work someone forgot to commit.
#
# THE SAME SHAPE AS A DEFECT ALREADY PAID FOR: a scratch directory under
# `content/` that vanished mid-walk produced five wrong diagnoses of a flaky
# suite, because nothing said it was scratch. Naming the pattern says so.
.tmp-build-*
